#include <bits/stdc++.h>
using namespace std;

struct Fenwick {
    int n;
    vector<long long> bit;

    Fenwick(int n) {
        this->n = n;
        bit.assign(n + 1, 0);
    }

    void update(int i, long long val) {
        for (; i <= n; i += i & -i)
            bit[i] += val;
    }

    long long query(int i) {
        long long s = 0;
        for (; i > 0; i -= i & -i)
            s += bit[i];
        return s;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;
    vector<long long> a(n);
    map<int,int>mp;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        mp[a[i]] =0;
    }
   int count =1;
    for(auto &it:mp){
        it.second = count++;
    }
    for(int i=0;i<n;i++){
        a[i] = mp[a[i]];
    }
    int maxi = *max_element(a.begin(),a.end());
    Fenwick fw(maxi);
    long long inv = 0;

    for (int i = 0; i < n; i++) {
        inv += fw.query(maxi) - fw.query(a[i]);
        fw.update(a[i], 1);
    }

    cout << inv << "\n";
    return 0;
}
